<arquillian xmlns="http://jboss.org/schema/arquillian"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://jboss.org/schema/arquillian
        http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
   <!-- Force the use of the Servlet 5.0 protocol with all containers, as it is the most mature -->
   <defaultProtocol type="Servlet 5.0" />

   <container qualifier="jboss" default="true">
        <configuration>
            <property name="serverConfig">standalone.xml</property>
            <property name="javaVmArguments">${server.jvm.args}</property>
            <property name="managementAddress">${node.address}</property>
            <property name="startupTimeoutInSeconds">${server.startup.timeout:60}</property>
        </configuration>
   </container>

    <extension qualifier="byteman">
        <!-- Byteman is loaded via -javaagent at JVM startup (surefire argLine for the client/test JVM,
             and byteman.agent.support for the WildFly server JVM in pom.xml) instead of a dynamic
             self-attach. This avoids the intermittent JDK libinstrument assertion during attach
             ("java.lang.instrument ASSERTION FAILED / createInstrumentationImpl failed"). The
             RuleInstallers just submit rules over TCP to the ports below. -->
        <property name="autoInstallAgent">false</property>
        <property name="clientAgentPort">9092</property>
        <property name="containerAgentPort">9091</property>
    </extension>

</arquillian>